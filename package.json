{
	"name": "hugopreview_nc_app",
	"version": "1.0.0",
	"description": "Hugo Preview - Nextcloud static site preview",
	"private": true,
	"scripts": {
		"build": "cross-env NODE_ENV=production webpack --progress --config webpack.config.js",
		"dev": "cross-env NODE_ENV=development webpack --progress --config webpack.config.js",
		"watch": "cross-env NODE_ENV=development webpack --progress --watch --config webpack.config.js",
		"lint": "eslint --ext .js,.vue src",
		"lint:fix": "eslint --ext .js,.vue --fix src"
	},
	"dependencies": {
		"@nextcloud/axios": "^2.5.0",
		"@nextcloud/dialogs": "^7.0.0",
		"@nextcloud/files": "^4.0.0",
		"@nextcloud/initial-state": "^2.2.0",
		"@nextcloud/l10n": "^3.1.0",
		"@nextcloud/router": "^3.0.1",
		"@nextcloud/vue": "^9.5.0",
		"vue": "^3.5.0",
		"vue-router": "^4.4.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@nextcloud/babel-config": "^1.2.0",
		"@nextcloud/browserslist-config": "^3.0.1",
		"@nextcloud/eslint-config": "^8.4.1",
		"@nextcloud/webpack-vue-config": "^7.0.2",
		"babel-loader": "^10.1.1",
		"cross-env": "^10.1.0",
		"css-loader": "^7.1.4",
		"node-polyfill-webpack-plugin": "^4.1.0",
		"sass": "^1.98.0",
		"sass-loader": "^16.0.7",
		"style-loader": "^4.0.0",
		"vue-loader": "^17.4.2",
		"vue-material-design-icons": "^5.3.0",
		"webpack": "^5.105.4",
		"webpack-cli": "^6.0.1"
	},
	"browserslist": [
		"extends @nextcloud/browserslist-config"
	]
}
